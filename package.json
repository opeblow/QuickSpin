{
  "name": "quickspin",
  "version": "1.0.0",
  "description": "QuickSpin — make waiting for AI fun. A monetizable, embeddable wait-game SDK for any AI app, built for the Commonsmade 'Make Waiting for AI Fun' hackathon.",
  "author": "QuickSpin team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opeblow/QuickSpin.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json}\" \"*.{json,md}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json}\" \"*.{json,md}\" \".github/workflows/*.yml\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
