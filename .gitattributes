# Normalize line endings to LF in the repo (checkout as-is on all platforms)
* text=auto

# Source
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf

# Docs
*.md      text eol=lf

# Config
*.yml     text eol=lf
*.yaml    text eol=lf

# Binaries
*.png     binary
*.jpg     binary
*.ico     binary